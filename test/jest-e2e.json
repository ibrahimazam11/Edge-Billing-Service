{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(.pnpm/uuid@[^/]+/node_modules/uuid|uuid)/)"
  ],
  "setupFiles": ["./helpers/setup.ts"],
  "testTimeout": 30000
}
